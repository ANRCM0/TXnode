# TX-Node 配置示例（一个文件启用一种模式；不要同时启用下列互斥配置）
# 默认展示 TXBoard 原生单节点。运行前请替换 URL、ID 和 Token。
# 保存为 config.yml，或使用 TXBoard-Deploy 的 Node 安装器生成正式部署配置。

# 方案 A（当前启用）：TXBoard 原生 Node
panel:
  provider: txboard
  url: "https://panel.example.com"
  token: "REPLACE_WITH_NODE_TOKEN"
  node_id: 1

kernel:
  type: txnode  # 唯一取值：原生 txnode 数据面（sing-box / Xray 已移除）

# 数据面行为参数（可省略，省略时使用括号内默认值）。
# dataplane:
#   trusted_proxies: "private,cloudflare"  # PROXY protocol 可信来源
#   proxy_protocol: false
#   require_proxy_protocol: false
#   auto_out_ip: false
#   diagnostics: false         # 显式启用固定字段的原生会话/代际/重载/待完成 I/O 指标
#   max_fresh: 4096            # 未认证并发上限
#   handshake_timeout: 10      # 秒
#   tcp_timeout: 300           # 秒，0 = 不超时
#   udp_timeout: 60            # 秒
#   forbidden_private_ip: false
#   forbidden_bittorrent: false
#   forbidden_ports: ""
#   user_tcp_limit: 0          # 每用户并发连接，0 = 不限
#   device_limit: 0            # 节点级设备上限，与面板取小
#   device_ipv6_prefix: 64
#   invalid_access_enable: false
#   invalid_access_count: 30
#   invalid_access_duration: 60
#   invalid_access_forbidden_time: 600
log:
  level: info
audit:
  enabled: false  # 可选访问审计（TXBoard 原生 API 或 Xboard 旧插件）；默认关闭

# 方案 B：TXBoard 原生 Machine（替换上面的 panel，并增加 machine；删除 panel.token/node_id）
# panel:
#   provider: txboard
#   url: "https://panel.example.com"
# machine:
#   machine_id: 2
#   token: "REPLACE_WITH_MACHINE_TOKEN"
# kernel:
#   type: txnode
# audit:
#   enabled: false

# 方案 C：Xboard 兼容单节点（替换方案 A 的 panel）
# panel:
#   provider: xboard  # 省略 provider 也是 xboard
#   url: "https://xboard.example.com"
#   token: "REPLACE_WITH_XBOARD_SERVER_TOKEN"
#   node_id: 3

# 方案 D：多面板实例（替换顶层 panel 后启用 instances）
# 顶层 kernel/log 可作为默认值，每个 instance 可单独覆盖。
# instances:
#   - panel:
#       provider: txboard
#       url: "https://txboard.example.com"
#       token: "REPLACE_WITH_TXBOARD_NODE_TOKEN"
#       node_id: 4
#   - panel:
#       provider: xboard
#       url: "https://xboard.example.com"
#       token: "REPLACE_WITH_XBOARD_SERVER_TOKEN"
#       node_id: 5
#   - panel:
#       provider: txboard
#       url: "https://txboard.example.com"
#     machine:
#       machine_id: 6
#       token: "REPLACE_WITH_TXBOARD_MACHINE_TOKEN"

# 可选嵌入式访问审计：原生钩子（每会话一次）；Xboard 使用已安装的旧插件，TXBoard 使用原生 TXAPI。
# 两者共用采集与规则匹配；仅在确认面板端已更新并做好隐私策略后开启。
# audit:
#   enabled: true
#   report_all: false   # false 只上报命中规则的事件，空规则集不产生上报
#   batch_max: 50
#   flush_interval: 15
#   rules_refresh: 5
#   queue_cap: 5000
#
# 运行时待确认流量批次和证书等数据位于 kernel.config_dir（默认配置文件目录）。
# Docker 部署请使用 Installer 提供的 /etc/txnode 持久化目录，避免重建容器丢数据。

# 可选有限授权：仅在 Core 启用独立 Ed25519 签名后启用。
# 公钥、Key/Core 身份须在受信配置中预先固定，不自动接受握手新密钥。
# 每个 Node/Machine 子节点分别持久保存授权版本，重启必须在线获取新快照。
# authorization:
#   enabled: true
#   state_dir: /etc/txnode/authorization
#   core_instance_id: REPLACE_WITH_PINNED_CORE_ID
#   key_id: REPLACE_WITH_PINNED_KEY_ID
#   key_epoch: "1"
#   public_key: REPLACE_WITH_BASE64URL_ED25519_PUBLIC_KEY
#   policy_version: native-node-authorization/v1
#   refresh_interval: 30   # 独立于面板 pull_interval，最大 30 秒
#   max_clock_skew: 5
# 密钥轮换须先更新受信配置；本阶段不自动接受密钥重叠或恢复旧状态。
# state_dir 与 kernel.config_dir 均须为 Linux 持久目录，不能随容器重建丢失。
# 离线最多运行至签名期限（最大 120 秒），到期关闭监听及已有连接。
# 本模式不能与隔离 Usage v2 同时启用；流量周期与授权期限分别处理。
# ?? instances: ??????????? instance ????? authorization:?
# ?? authorization.enabled: true ? instances: ?????????????????????
