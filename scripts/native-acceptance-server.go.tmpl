package main

import (
	"context"
	"encoding/json"
	"flag"
	"fmt"
	"net"
	"os"
	"os/signal"
	"path/filepath"
	"runtime"
	"runtime/pprof"
	"strconv"
	"strings"
	"syscall"
	"time"

	"golang.org/x/sys/unix"

	"github.com/ANRCM0/TX-Node/internal/kernel"
	"github.com/ANRCM0/TX-Node/internal/model"
	"github.com/ANRCM0/TX-Node/internal/usagebucket"
	"github.com/ANRCM0/TX-Node/internal/usageinterval"
	"github.com/ANRCM0/TX-Node/internal/usagev2"
)

const cpuMethod = "process-cputime-ns-v1"

func writeCPUSnapshot(root, nonce string, sequence int) {
	var before, after, cpu, resolution unix.Timespec
	for _, read := range []struct {
		clock int32
		value *unix.Timespec
	}{{unix.CLOCK_MONOTONIC, &before}, {unix.CLOCK_PROCESS_CPUTIME_ID, &cpu}, {unix.CLOCK_MONOTONIC, &after}} {
		if err := unix.ClockGettime(read.clock, read.value); err != nil {
			panic(err)
		}
	}
	if err := unix.ClockGetres(unix.CLOCK_PROCESS_CPUTIME_ID, &resolution); err != nil {
		panic(err)
	}
	if nonce == "" || sequence < 1 || sequence > 2 || resolution.Nano() <= 0 {
		panic("invalid process CPU snapshot request")
	}
	body, err := json.Marshal(map[string]any{
		"schema": "txnode-process-cpu-snapshot/v1", "method": cpuMethod,
		"clock_id": unix.CLOCK_PROCESS_CPUTIME_ID, "pid": os.Getpid(), "nonce": nonce, "sequence": sequence,
		"cpu_nanos": cpu.Nano(), "resolution_nanos": resolution.Nano(),
		"monotonic_before_nanos": before.Nano(), "monotonic_after_nanos": after.Nano(),
	})
	if err != nil {
		panic(err)
	}
	name := filepath.Join(root, fmt.Sprintf("cpu-%d.json", sequence))
	if err := os.WriteFile(name+".tmp", body, 0600); err != nil {
		panic(err)
	}
	if err := os.Rename(name+".tmp", name); err != nil {
		panic(err)
	}
}

func main() {
	mode := flag.String("mode", "ordinary", "ordinary, events, usage_v2")
	root := flag.String("state", "", "fresh state directory")
	flag.Parse()
	if *root == "" {
		panic("state directory required")
	}
	if path := os.Getenv("TXNODE_NATIVE_AB_CPU_PROFILE"); path != "" {
		profile, err := os.Create(path)
		if err != nil {
			panic(err)
		}
		if err := pprof.StartCPUProfile(profile); err != nil {
			_ = profile.Close()
			panic(err)
		}
		defer func() { pprof.StopCPUProfile(); _ = profile.Close() }()
	}
	node := makeKernel()
	var coordinator *usagebucket.Coordinator
	var collector *usageinterval.NativeCollector
	var store *usageinterval.NativeStore
	var spool *usagev2.Spool
	var err error
	switch *mode {
	case "ordinary":
	case "events":
		coordinator, err = usagebucket.NativeABNewCoordinator(filepath.Join(*root, "events"), usagebucket.StoreOptions{MaxBytes: 1 << 30}, usagebucket.CoordinatorOptions{})
		if err != nil || !node.SetLocalEventConsumer(coordinator) {
			panic(fmt.Sprintf("event installation: %v", err))
		}
	case "usage_v2":
		now := time.Now().Unix()
		session := usagev2.Session{ProtocolVersion: 2, CoreInstanceID: "native-ab", NodeID: "3", SourceEpoch: "5", ReceiptGeneration: "1", RetentionSeconds: 86400, MaxLateReportSeconds: 3600, ReceiptRetentionSeconds: 86400, IssuedAt: now - 1,
			Grants: []usagev2.Grant{{UserID: "7", AccessSubjectID: "8", AuthSnapshotID: "11", TariffRevisionID: "12", TermsID: "13", UsagePeriodID: "14", IssuedAt: now - 1, LeaseExpiresAt: now + 90, RevocationVersion: "0"}}}
		spool, err = usagev2.OpenSpool(filepath.Join(*root, "spool"), 0)
		if err != nil {
			panic(err)
		}
		store, err = usageinterval.OpenNativeStore(filepath.Join(*root, "native"), session, spool)
		if err != nil {
			panic(err)
		}
		collector, err = store.NewCollector(session, usageinterval.NativeWindow{Revision: "1", Digest: strings.Repeat("a", 64), IssuedAt: now - 1, ExpiresAt: now + 90}, map[string]int{"native-ab-secret": 7})
		if err != nil {
			panic(err)
		}
		if delay := time.Until(collector.ReadyAt()); delay > 0 {
			time.Sleep(delay)
		}
		if !installNative(node, collector) {
			panic("native usage installation refused")
		}
	default:
		panic("unsupported mode")
	}
	listener, err := net.Listen("tcp4", "127.0.0.1:0")
	if err != nil {
		panic(err)
	}
	port := listener.Addr().(*net.TCPAddr).Port
	_ = listener.Close()
	spec := &model.NodeSpec{Protocol: "socks", ListenIP: "127.0.0.1", ServerPort: port,
		CustomRouteRules: []model.CustomRouteRule{{Name: "benchmark-loopback", Match: model.RouteMatch{IPCIDRs: []string{"127.0.0.1/32"}}, Action: model.RouteAction{Type: "direct"}}}}
	if err := node.Start(spec, []model.UserSpec{{ID: 7, UUID: "native-ab-secret"}}, kernel.TLSCert{}); err != nil {
		panic(err)
	}
	fmt.Println("NATIVE_AB_READY " + strconv.Itoa(port))
	signals := make(chan os.Signal, 4)
	signal.Notify(signals, syscall.SIGTERM, syscall.SIGINT, syscall.SIGUSR1, syscall.SIGUSR2)
	cpuSnapshots := 0
	for snapshots := 0; ; {
		received := <-signals
		if received == syscall.SIGUSR2 {
			cpuSnapshots++
			writeCPUSnapshot(*root, os.Getenv("TXNODE_NATIVE_AB_CPU_NONCE"), cpuSnapshots)
			continue
		}
		if received != syscall.SIGUSR1 {
			break
		}
		var memory runtime.MemStats
		runtime.ReadMemStats(&memory)
		snapshots++
		body, _ := json.Marshal(map[string]uint64{"total_alloc_bytes": memory.TotalAlloc, "mallocs": memory.Mallocs, "heap_bytes": memory.HeapAlloc})
		name := filepath.Join(*root, fmt.Sprintf("runtime-%d.json", snapshots))
		if err := os.WriteFile(name+".tmp", body, 0600); err != nil {
			panic(err)
		}
		if err := os.Rename(name+".tmp", name); err != nil {
			panic(err)
		}
	}
	node.Stop()
	if coordinator != nil {
		writeBucketDiagnostic(*root, "bucket-after-node-stop.json", coordinator)
	}
	evidence := map[string]any{"mode": *mode, "stopped": true}
	if collector != nil {
		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		err = collector.Drain(ctx)
		cancel()
		if err != nil {
			panic(err)
		}
		records, e := spool.Records()
		if e != nil || len(records) == 0 {
			panic(fmt.Sprintf("missing durable usage records: %v", e))
		}
		evidence["usage_records"] = len(records)
		var up, down uint64
		for _, record := range records {
			for _, entry := range record.Submission.Payload.Entries {
				n, e := strconv.ParseUint(entry.RawUpBytes, 10, 64)
				if e != nil {
					panic(e)
				}
				up += n
				n, e = strconv.ParseUint(entry.RawDownBytes, 10, 64)
				if e != nil {
					panic(e)
				}
				down += n
			}
		}
		evidence["usage_raw_up_bytes"], evidence["usage_raw_down_bytes"] = up, down
		if err = store.Close(); err != nil {
			panic(err)
		}
		if err = spool.Close(); err != nil {
			panic(err)
		}
	}
	if coordinator != nil {
		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		err = coordinator.Close(ctx)
		cancel()
		writeBucketDiagnostic(*root, "bucket-after-coordinator-close.json", coordinator)
		if err != nil {
			panic(err)
		}
		status, ok := coordinator.StoreSnapshot()
		if !ok || status.Buckets == 0 || status.Degraded {
			panic(fmt.Sprintf("event evidence incomplete: %+v %v", status, ok))
		}
		evidence["event_store"] = status
		var up, down int64
		var eventCount uint64
		paths := map[string]uint64{}
		for sequence := uint64(1); sequence <= status.Sequence; sequence++ {
			record, readErr := coordinator.ReadRecord(sequence)
			if readErr != nil {
				panic(readErr)
			}
			if record.Authorizes || record.Attribution != "unattributable" || !record.TailUnknown || !record.RestoreUnknown {
				panic("local observation changed its authority or unknown-tail semantics")
			}
			if record.Bucket == nil {
				continue
			}
			if record.Capture == nil || record.Capture.Degraded || record.Capture.DroppedEvents != 0 {
				panic("local observation lost events")
			}
			up += record.Bucket.PhysicalTotals[0]
			down += record.Bucket.PhysicalTotals[1]
			for _, event := range record.Bucket.Events {
				if event.UserID != 7 || event.Attribution != "unattributable" {
					panic("local observation changed its original user or attribution")
				}
				eventCount++
				paths[string(event.Path)]++
			}
		}
		evidence["event_contract"] = "physical-byte-observation-v1"
		evidence["event_raw_up_bytes"], evidence["event_raw_down_bytes"] = up, down
		evidence["event_count"], evidence["event_paths"] = eventCount, paths
		evidence["event_authorizes"], evidence["event_tail_unknown"] = false, true
	}
	body, _ := json.MarshalIndent(evidence, "", "  ")
	if err = os.WriteFile(filepath.Join(*root, "evidence.json"), body, 0600); err != nil {
		panic(err)
	}
}

func writeBucketDiagnostic(root, name string, coordinator *usagebucket.Coordinator) {
	body, err := json.MarshalIndent(coordinator.NativeABSnapshot(), "", "  ")
	if err == nil {
		err = os.WriteFile(filepath.Join(root, name), body, 0600)
	}
	if err != nil {
		fmt.Fprintln(os.Stderr, "NATIVE_AB_BUCKET_DIAGNOSTIC_WRITE_FAILED")
	}
}
