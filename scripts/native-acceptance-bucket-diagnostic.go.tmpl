package usagebucket

import (
	"math/bits"
	"os"
	"sync"
	"sync/atomic"
	"time"
)

const nativeABDiagnosticEnv = "TXNODE_NATIVE_AB_EVENT_DIAGNOSTICS"

var nativeABPersistenceObservers sync.Map

type nativeABStageBoundary struct{ from, to, name string }

var nativeABStageBoundaries = [...]nativeABStageBoundary{
	{"before_write", "before_file_sync", "record_open_write"},
	{"before_file_sync", "after_file_sync", "record_file_sync_wall"},
	{"after_file_sync", "before_publish", "record_close"},
	{"before_publish", "before_dir_sync", "record_publish"},
	{"before_dir_sync", "after_dir_sync", "record_directory_sync_wall"},
	{"after_dir_sync", "before_head_sync", "head_encode_open_write"},
	{"before_head_sync", "after_head_sync", "head_file_sync_wall"},
	{"after_head_sync", "before_head_publish", "head_close"},
	{"before_head_publish", "before_head_dir_sync", "head_publish"},
	{"before_head_dir_sync", "after_head_dir_sync", "head_directory_sync_wall"},
	{"after_head_dir_sync", "before_pending_remove", "head_return"},
	{"before_pending_remove", "before_cleanup_dir_sync", "pending_remove"},
	{"before_cleanup_dir_sync", "before_ack", "cleanup_sync_and_state_publication"},
	{"before_ack", "after_ack", "private_ack"},
	{"after_ack", "before_write", "worker_gap_including_idle_encode_validate"},
}

type nativeABStageTiming struct {
	Name          string     `json:"name"`
	Count         uint64     `json:"count"`
	TotalNanos    uint64     `json:"total_nanos"`
	MaxNanos      uint64     `json:"max_nanos"`
	Log2Histogram [64]uint64 `json:"log2_nanoseconds_histogram"`
}

type nativeABMeterBacklog struct {
	Tracker        string `json:"tracker"`
	OpenEvents     int    `json:"open_events"`
	SealedEvents   int    `json:"sealed_events"`
	SealedBuckets  int    `json:"sealed_buckets"`
	ClaimBucket    uint64 `json:"claim_bucket"`
	ClaimEvents    int    `json:"claim_events"`
	NextSequence   uint64 `json:"next_sequence"`
	Persisted      uint64 `json:"persisted_buckets"`
	Dropped        uint64 `json:"dropped_events"`
	DegradedReason string `json:"degraded_reason"`
}

type nativeABBacklogSample struct {
	ElapsedNanos  int64                   `json:"elapsed_nanos"`
	Boundary      string                  `json:"boundary"`
	InFlight      bool                    `json:"in_flight"`
	StoreSequence uint64                  `json:"store_sequence"`
	MeterCount    int                     `json:"meter_count"`
	Meters        [8]nativeABMeterBacklog `json:"meters"`
}

type nativeABPersistenceDiagnostic struct {
	Schema                 string                  `json:"schema"`
	Scope                  string                  `json:"scope"`
	HistogramRule          string                  `json:"histogram_rule"`
	SampleCapacity         int                     `json:"sample_capacity"`
	SamplesSeen            uint64                  `json:"samples_seen"`
	LastBoundary           string                  `json:"last_boundary"`
	SinceLastBoundaryNanos int64                   `json:"since_last_boundary_nanos"`
	Stages                 []nativeABStageTiming   `json:"stages"`
	Backlog                []nativeABBacklogSample `json:"backlog"`
}

type nativeABPersistenceObserver struct {
	mu          sync.Mutex
	started     time.Time
	lastAt      time.Time
	lastStage   string
	stages      [len(nativeABStageBoundaries)]nativeABStageTiming
	samples     [64]nativeABBacklogSample
	samplesSeen uint64
	coordinator atomic.Pointer[Coordinator]
}

// NativeABNewCoordinator changes only the explicitly enabled disposable harness.
// Formal samples retain the production constructor, with no hook or sampler.
func NativeABNewCoordinator(dir string, storeOptions StoreOptions, options CoordinatorOptions) (*Coordinator, error) {
	if os.Getenv(nativeABDiagnosticEnv) != "1" {
		return NewAsyncCoordinator(dir, storeOptions, options)
	}
	observer := &nativeABPersistenceObserver{started: time.Now()}
	for i, boundary := range nativeABStageBoundaries {
		observer.stages[i].Name = boundary.name
	}
	coordinator, err := newAsyncCoordinator(options, func() (*Store, error) {
		return openStore(dir, storeOptions, observer.hook)
	})
	if err != nil {
		return nil, err
	}
	observer.coordinator.Store(coordinator)
	nativeABPersistenceObservers.Store(coordinator, observer)
	return coordinator, nil
}

func (o *nativeABPersistenceObserver) hook(stage string) error {
	now := time.Now()
	o.mu.Lock()
	for i, boundary := range nativeABStageBoundaries {
		if o.lastStage == boundary.from && stage == boundary.to {
			elapsed := uint64(now.Sub(o.lastAt))
			timing := &o.stages[i]
			timing.Count++
			timing.TotalNanos += elapsed
			if elapsed > timing.MaxNanos {
				timing.MaxNanos = elapsed
			}
			bin := bits.Len64(elapsed)
			if bin > 0 {
				bin--
			}
			timing.Log2Histogram[bin]++
			break
		}
	}
	o.lastStage, o.lastAt = stage, now
	o.mu.Unlock()
	if stage == "before_write" || stage == "after_ack" {
		if coordinator := o.coordinator.Load(); coordinator != nil {
			o.sample(coordinator, stage)
		}
	}
	return nil
}

func (o *nativeABPersistenceObserver) sample(c *Coordinator, boundary string) {
	var meters [8]*Meter
	sample := nativeABBacklogSample{ElapsedNanos: time.Since(o.started).Nanoseconds(), Boundary: boundary}
	c.mu.Lock()
	sample.MeterCount = copy(meters[:], c.meters)
	sample.InFlight = c.status.InFlight
	c.mu.Unlock()
	for i, meter := range meters[:sample.MeterCount] {
		meter.mu.Lock()
		backlog := nativeABMeterBacklog{
			Tracker: meter.open.TrackerID, OpenEvents: len(meter.open.Events), SealedBuckets: len(meter.sealed),
			NextSequence: meter.nextSequence, Persisted: meter.persisted, Dropped: meter.dropped, DegradedReason: meter.degraded,
		}
		for _, bucket := range meter.sealed {
			backlog.SealedEvents += len(bucket.Events)
		}
		if meter.claim != nil {
			backlog.ClaimBucket, backlog.ClaimEvents = meter.claim.bucket.Number, len(meter.claim.bucket.Events)
		}
		meter.mu.Unlock()
		sample.Meters[i] = backlog
	}
	if store, ok := c.StoreSnapshot(); ok {
		sample.StoreSequence = store.Sequence
	}
	o.mu.Lock()
	o.samples[o.samplesSeen%uint64(len(o.samples))] = sample
	o.samplesSeen++
	o.mu.Unlock()
}

func (o *nativeABPersistenceObserver) snapshot(c *Coordinator) *nativeABPersistenceDiagnostic {
	o.sample(c, "snapshot")
	o.mu.Lock()
	defer o.mu.Unlock()
	result := &nativeABPersistenceDiagnostic{
		Schema:         "txnode-native-persistence-diagnostic/v1",
		Scope:          "diagnostics only; wall stages include scheduling and observer overhead; startup/control records included; independent lock reads; bounded backlog sampled at before_write/after_ack/snapshot, no periodic samples",
		HistogramRule:  "bin 0: [0,2) ns; bin n>0: [2^n,2^(n+1)) ns",
		SampleCapacity: len(o.samples), SamplesSeen: o.samplesSeen, LastBoundary: o.lastStage,
		Stages: append([]nativeABStageTiming(nil), o.stages[:]...),
	}
	if !o.lastAt.IsZero() {
		result.SinceLastBoundaryNanos = time.Since(o.lastAt).Nanoseconds()
	}
	count := o.samplesSeen
	if count > uint64(len(o.samples)) {
		count = uint64(len(o.samples))
	}
	result.Backlog = make([]nativeABBacklogSample, 0, count)
	for i := o.samplesSeen - count; i < o.samplesSeen; i++ {
		result.Backlog = append(result.Backlog, o.samples[i%uint64(len(o.samples))])
	}
	return result
}

// NativeABDiagnostic is a bounded observational snapshot for the temporary A/B harness.
// The independently locked statuses do not describe one atomic owner transition.
type NativeABDiagnostic struct {
	Schema            string                         `json:"schema"`
	Coordinator       CoordinatorStatus              `json:"coordinator"`
	Store             StoreStatus                    `json:"store"`
	StoreExists       bool                           `json:"store_exists"`
	Meters            []Status                       `json:"meters"`
	PersistenceStages *nativeABPersistenceDiagnostic `json:"persistence_stages,omitempty"`
}

// NativeABSnapshot exists only in disposable measurement checkouts.
func (c *Coordinator) NativeABSnapshot() NativeABDiagnostic {
	var meters [8]*Meter
	c.mu.Lock()
	n := copy(meters[:], c.meters)
	c.mu.Unlock()

	snapshot := NativeABDiagnostic{
		Schema: "txnode-native-bucket-diagnostic/v1",
		Meters: make([]Status, 0, n),
	}
	for _, meter := range meters[:n] {
		snapshot.Meters = append(snapshot.Meters, meter.Status())
	}
	snapshot.Coordinator = c.Status()
	snapshot.Store, snapshot.StoreExists = c.StoreSnapshot()
	if observer, ok := nativeABPersistenceObservers.Load(c); ok {
		snapshot.PersistenceStages = observer.(*nativeABPersistenceObserver).snapshot(c)
	}
	return snapshot
}
